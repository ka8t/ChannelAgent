# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- Application-layer encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This key encrypts sensitive fields at rest (emails, Matrix tokens, access keys).
# It must live only here, never in the database and never in Git history.
ENCRYPTION_KEY=

# --- Database ---
# Local-first: SQLite file on the Docker volume. Swap for a Postgres DSN later
# without changing application code (SQLAlchemy handles both).
DATABASE_URL=sqlite+aiosqlite:///./data/channelagent.db

# --- Local LLM gateway (llama-server on the Mac host) ---
# From inside the Linux container, the Mac host is reached via
# host.docker.internal, not localhost. start.sh overrides this to
# localhost automatically when run with --native (see its own comments).
LLAMA_SERVER_URL=http://host.docker.internal:8080
LLAMA_CTX_SIZE=65536
MODEL_FILE=

# --- Native llama-server auto-start (macOS dev only, start.sh) ---
# Not read by the Python app (app/config.py ignores unknown vars) —
# only start.sh uses these, to launch llama-server itself when it isn't
# already running on LLAMA_PORT. Leave empty to disable auto-start and
# manage llama-server yourself.
LLAMA_PORT=8080
LLAMA_SERVER_BIN=
MODELS_DIR=

# --- Telegram adapter ---
TELEGRAM_BOT_TOKEN=
# Bootstrap only (#14, not yet implemented) — seeds the first admin user
# once, then is never consulted again. Not the authorization mechanism.
TELEGRAM_ALLOWED_USERS=

# --- Email (IMAP/SMTP) adapter ---
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- Matrix/Element adapter ---
MATRIX_HOMESERVER_URL=
MATRIX_USER_ID=
MATRIX_ACCESS_TOKEN=

# --- Admin API ---
API_SERVER_PORT=8700
API_SERVER_KEY=
